{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kishka Browser",
  "version": "1.5.0",
  "identifier": "com.kishka.browser",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Kishka Browser V1.5",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
